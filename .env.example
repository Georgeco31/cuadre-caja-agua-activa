# General
PROJECT_NAME=Cuadre de Caja Agua Activa
ENVIRONMENT=development

# Backend
API_SERVICE_NAME=cuadre-caja-api
API_V1_PREFIX=/api/v1
API_HOST=0.0.0.0
API_PORT=8000
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Frontend
WEB_HOST=0.0.0.0
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8010/api/v1

# Database
POSTGRES_DB=cuadre_caja
POSTGRES_USER=cuadre_user
POSTGRES_PASSWORD=cuadre_password
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://cuadre_user:cuadre_password@db:5432/cuadre_caja

# Initial admin seed
# Cambiar ADMIN_PASSWORD en cualquier entorno real.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_IS_ACTIVE=true

# Authentication
AUTH_SECRET_KEY=change-this-secret-in-production
AUTH_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
