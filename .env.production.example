# Copiar como .env.production.local y reemplazar todos los valores CHANGE_ME.
# Este archivo es solo una plantilla: no contiene credenciales utilizables.

# Aplicacion
PROJECT_NAME=Agua Activa ERP
API_SERVICE_NAME=agua-activa-erp-api
API_V1_PREFIX=/api/v1
ENVIRONMENT=production
TZ=America/Guayaquil

# PostgreSQL interno (5432 no se publica hacia el host)
POSTGRES_DB=agua_activa_erp
POSTGRES_USER=agua_activa_app
POSTGRES_PASSWORD=CHANGE_ME_WITH_A_LONG_UNIQUE_DATABASE_PASSWORD
DATABASE_URL=postgresql+psycopg://agua_activa_app:CHANGE_ME_URL_ENCODED_DATABASE_PASSWORD@db:5432/agua_activa_erp

# Autenticacion y seed inicial
AUTH_SECRET_KEY=CHANGE_ME_WITH_AT_LEAST_32_RANDOM_CHARACTERS
AUTH_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_WITH_A_LONG_UNIQUE_INITIAL_ADMIN_PASSWORD
ADMIN_IS_ACTIVE=true

# Red local
# En la prueba del MacBook se puede usar localhost. En la futura PC servidor,
# reemplazar SERVER_LAN_IP por la IP o nombre LAN aprobado en el Bloque 55B.
CORS_ORIGINS=["http://localhost:3000","http://SERVER_LAN_IP:3000"]
NEXT_PUBLIC_API_URL=http://SERVER_LAN_IP:8010/api/v1
API_BIND_ADDRESS=0.0.0.0
API_PORT=8010
WEB_BIND_ADDRESS=0.0.0.0
WEB_PORT=3000
